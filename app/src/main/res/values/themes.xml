<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main App Theme -->
    <style name="Theme.MahfilHub" parent="android:Theme.Material.Light.NoActionBar" />
    
    <!-- Splash Screen Theme - Minimal system splash, blends into custom Compose splash -->
    <style name="Theme.MahfilHub.Splash" parent="Theme.SplashScreen">
        <!-- Background color - teal brand color to seamlessly blend into custom splash -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        
        <!-- Status bar - teal with white icons from the very first frame -->
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Post splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.MahfilHub</item>
    </style>
</resources>